{
  "opencollection": "1.0.0",
  "info": {
    "name": "Backstage Software Catalog Entities Locations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List registered locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7007/api/catalog/locations"
          },
          "docs": "List registered locations"
        },
        {
          "info": {
            "name": "Register a new location",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:7007/api/catalog/locations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a new location"
        },
        {
          "info": {
            "name": "Delete a location",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:7007/api/catalog/locations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a location"
        }
      ]
    }
  ],
  "bundled": true
}